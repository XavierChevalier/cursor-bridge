#!/usr/bin/env bash
# Deterministic Cursor CLI stand-in for contract tests.
set -euo pipefail

STATE_DIR="${FAKE_AGENT_STATE_DIR:-${CURSOR_BRIDGE_STATE_DIR:-/tmp/fake-agent-state}}"
mkdir -p "${STATE_DIR}"

if [[ "${1:-}" == "status" ]]; then
  if [[ -f "${STATE_DIR}/logged_in" ]]; then
    echo "Logged in as fake@example.com"
  else
    echo "Not logged in"
  fi
  exit 0
fi

if [[ "${1:-}" == "login" ]]; then
  echo "Open this URL to authenticate:"
  echo "https://authenticator.cursor.sh/login?token=fake-test-token"
  # Stay alive until credentials land (real CLI waits for browser OAuth).
  while [[ ! -f "${STATE_DIR}/logged_in" ]]; do
    sleep 0.05
  done
  exit 0
fi

# Shared with model-discovery contracts (other parallel work).
if [[ "${1:-}" == "models" ]]; then
  cat <<'EOF'
Available models
auto - Auto (current, default)
composer-2.5 - Composer 2.5
gpt-5.2 - GPT-5.2
EOF
  exit 0
fi

print_mode=0
stream_partial=0
output_format="text"
prompt=""
prev=""
for arg in "$@"; do
  case "${arg}" in
  -p | --print)
    print_mode=1
    ;;
  --trust | -f | --yolo | --force)
    ;;
  --stream-partial-output)
    stream_partial=1
    ;;
  --output-format | --model)
    prev="${arg}"
    ;;
  *)
    if [[ "${prev}" == "--output-format" ]]; then
      output_format="${arg}"
      prev=""
      continue
    fi
    if [[ "${prev}" == "--model" ]]; then
      prev=""
      continue
    fi
    if [[ "${arg}" != -* ]]; then
      prompt="${arg}"
    fi
    prev=""
    ;;
  esac
done

json_escape() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '%s' "${s}"
}

emit_assistant_delta() {
  local text
  text="$(json_escape "$1")"
  local ts_ms
  ts_ms=$(($(date +%s) * 1000))
  printf '%s\n' "{\"type\":\"assistant\",\"timestamp_ms\":${ts_ms},\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"${text}\"}]}}"
}

if [[ "${print_mode}" -eq 1 ]]; then
  has_force=0
  for arg in "$@"; do
    case "${arg}" in
    -f | --force | --yolo) has_force=1 ;;
    esac
  done
  if [[ "${has_force}" -ne 1 ]]; then
    echo "fake-agent: print mode requires --force" >&2
    exit 2
  fi

  if [[ "${output_format}" == "stream-json" ]]; then
    if [[ "${stream_partial}" -ne 1 ]]; then
      echo "fake-agent: stream-json fixture expects --stream-partial-output" >&2
      exit 2
    fi
    local_half=$((${#prompt} / 2))
    if [[ "${local_half}" -lt 1 ]]; then
      local_half=${#prompt}
    fi
    first="${prompt:0:local_half}"
    second="${prompt:local_half}"
    emit_assistant_delta "${first}"
    if [[ "${prompt}" == *"__SLOW_STREAM__"* ]]; then
      sleep 0.4
    fi
    if [[ -n "${second}" ]]; then
      emit_assistant_delta "${second}"
    fi
    full="$(json_escape "${prompt}")"
    printf '%s\n' "{\"type\":\"assistant\",\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"${full}\"}]}}"
    printf '%s\n' "{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"${full}\",\"session_id\":\"fake-session\"}"
    exit 0
  fi

  # Text mode also honors the slow marker so pre-fix contract tests can prove
  # the HTTP handler waited for `.output()` before writing any SSE bytes.
  if [[ "${prompt}" == *"__SLOW_STREAM__"* ]]; then
    sleep 0.4
  fi
  printf '%s' "${prompt}"
  exit 0
fi

echo "fake-agent: unexpected args: $*" >&2
exit 2
