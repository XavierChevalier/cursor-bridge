#!/usr/bin/env bash
# Deterministic Cursor CLI stand-in for contract tests.
set -euo pipefail

STATE_DIR="${FAKE_AGENT_STATE_DIR:-${CURSOR_BRIDGE_STATE_DIR:-/tmp/fake-agent-state}}"
mkdir -p "${STATE_DIR}"

if [[ "${1:-}" == "status" ]]; then
  if [[ -f "${STATE_DIR}/logged_in" ]]; then
    echo "Logged in as fake@example.com"
  else
    echo "Not logged in"
  fi
  exit 0
fi

if [[ "${1:-}" == "login" ]]; then
  touch "${STATE_DIR}/logged_in"
  echo "Open this URL to authenticate:"
  echo "https://authenticator.cursor.sh/login?token=fake-test-token"
  exit 0
fi

print_mode=0
prompt=""
prev=""
for arg in "$@"; do
  case "${arg}" in
    -p | --print)
      print_mode=1
      ;;
    --output-format | --model)
      prev="${arg}"
      ;;
    text | default | *)
      if [[ "${prev}" == "--output-format" || "${prev}" == "--model" ]]; then
        prev=""
        continue
      fi
      if [[ "${arg}" != -* ]]; then
        prompt="${arg}"
      fi
      prev=""
      ;;
  esac
done

if [[ "${print_mode}" -eq 1 ]]; then
  printf '%s' "${prompt}"
  exit 0
fi

echo "fake-agent: unexpected args: $*" >&2
exit 2
