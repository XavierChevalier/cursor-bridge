# Copy to .env and fill locally. Never commit .env.
# All values below are placeholders.

# Listen address for the OpenAI-compatible HTTP API
CURSOR_BRIDGE_HOST=127.0.0.1
CURSOR_BRIDGE_PORT=8787

# Path to the Cursor CLI binary (`agent`) on the host or in the container
CURSOR_BRIDGE_AGENT_BIN=agent

# Working directory the agent is allowed to use for tools
CURSOR_BRIDGE_WORKSPACE=./workspace

# Model id exposed on /v1/models (maps to Cursor Auto by default)
CURSOR_BRIDGE_MODEL_ID=cursor-auto
CURSOR_BRIDGE_CURSOR_MODEL=default

# Optional: API key clients must send as Bearer token.
# Leave empty only for loopback-only development.
# Generate your own secret; do not reuse examples from docs.
CURSOR_BRIDGE_API_KEY=

# Optional Cursor API key (alternative to `agent login`).
# Prefer interactive login when possible; if set, inject via env at runtime
# and never bake into images or compose files committed to git.
# CURSOR_API_KEY=
